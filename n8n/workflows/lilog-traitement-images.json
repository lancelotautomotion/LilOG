      "id": "node-list-images",
      "name": "Lister les images du dossier",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        460,
        700
      ],
      "alwaysOutputData": true,
      "retryOnFail": true,
      "maxTries": 3,
      "notes": "alwaysOutputData = true pour ne pas bloquer la boucle sur un dossier vide"
    },
    {
      "parameters": {
        "jsCode": "// Trie les images du dossier courant et désigne la photo principale.\nconst folder = $('Boucle dossiers').first().json;\n\nconst slug = String(folder.name || 'produit')\n  .normalize('NFD')\n  .replace(/[\\u0300-\\u036f]/g, '')\n  .toLowerCase()\n  .replace(/[^a-z0-9]+/g, '-')\n  .replace(/^-+|-+$/g, '') || 'produit';\n\nconst images = $input.all()\n  .filter((i) => typeof i.json.mimeType === 'string' && i.json.mimeType.startsWith('image/'))\n  .sort((a, b) => String(a.json.name).localeCompare(String(b.json.name), 'fr', { numeric: true }));\n\n// Dossier vide : on renvoie un marqueur, le dossier sera ignoré (pas de renommage).\nif (images.length === 0) {\n  return [{ json: { empty: true, folderId: folder.id, folderName: folder.name } }];\n}\n\n// Photo principale : nom contenant main / principale / cover / 1, sinon la première.\nconst MAIN_RE = /(^|[\\s_.-])(main|principale?|cover|couverture|0?1)([\\s_.-]|$)/i;\nlet mainIndex = images.findIndex((i) => MAIN_RE.test(String(i.json.name).replace(/\\.[^.]+$/, '')));\nif (mainIndex === -1) mainIndex = 0;\n\n// La principale passe en tête : elle est donc toujours l'item [0] de ce nœud.\nconst ordered = [images[mainIndex], ...images.filter((_, idx) => idx !== mainIndex)];\n\nreturn ordered.map((img, idx) => ({\n  json: {\n    id: img.json.id,\n    name: img.json.name,\n    mimeType: img.json.mimeType,\n    isMain: idx === 0,\n    position: idx + 1,\n    newName: `${slug}-${String(idx + 1).padStart(2, '0')}.webp`,\n    folderId: folder.id,\n    folderName: folder.name,\n    empty: false,\n  },\n}));"
      },
