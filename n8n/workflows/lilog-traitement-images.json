    {
      "parameters": {
        "jsCode": "// Récapitulatif des dossiers validés pendant cette exécution.\nconst dossiers = $input.all()\n  .filter((i) => i.json && i.json.name && i.json.empty !== true)\n  .map((i) => i.json.name);\n\nreturn [{\n  json: {\n    event: 'lilog_images_ready',\n    prefix: $('Config').first().json.PREFIXE_TRAITE,\n    foldersProcessed: dossiers.length,\n    folders: dossiers,\n    finishedAt: new Date().toISOString(),\n  },\n}];"
      },
