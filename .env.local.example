# ─────────────────────────────────────────────────────────────────────────
# Variables d'environnement — à poser dans Vercel
# (Settings → Environment Variables), jamais dans un fichier du dépôt.
# Ce fichier ne sert que de référence : il liste tout ce que le code lit.
# ─────────────────────────────────────────────────────────────────────────

# ── Shopify Storefront API ──
# Voir README.md pour la génération du token dans l'admin Shopify.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-storefront-api-access-token
# Shopify ne maintient chaque version que 12 mois : une version expirée est
# basculée d'office, et les champs supprimés entre-temps disparaissent sans
# prévenir. À vérifier sur shopify.dev/docs/api/usage/versioning.
SHOPIFY_STOREFRONT_API_VERSION=2025-01

# ── NextAuth ──
# Générer avec : npx auth secret
# Signe les cookies de session. Peut (et doit) tourner régulièrement :
# une rotation déconnecte toutes les clientes, sans autre conséquence
# — à condition que SHOPIFY_SHADOW_SECRET ci-dessous soit posé.
AUTH_SECRET=your-auth-secret-here

# ── Comptes Shopify miroir (connexion Google) ──
# Dérive le mot de passe Shopify des comptes créés via Google.
# DISTINCT d'AUTH_SECRET à dessein : le faire tourner prive toutes les
# clientes Google de leur historique de commandes et de leur carnet
# d'adresses. À initialiser avec la valeur COURANTE d'AUTH_SECRET pour ne
# casser aucun compte existant, puis à ne plus jamais changer.
# Si absent, le code se replie sur AUTH_SECRET (comportement historique).
SHOPIFY_SHADOW_SECRET=same-value-as-your-current-auth-secret

# ── Google OAuth ──
# À créer sur https://console.cloud.google.com/apis/credentials
# URI de redirection autorisée : https://your-domain.com/api/auth/callback/google
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret

# ── URL de l'app (requis par NextAuth en production) ──
NEXTAUTH_URL=https://your-domain.com

# ── Formulaire de contact (Resend) ──
# Sans RESEND_API_KEY, /api/contact répond 500 et le formulaire affiche une
# erreur franche plutôt qu'un faux « message transmis ».
RESEND_API_KEY=re_your_resend_api_key
# Facultatif. Défaut : lilog.shop@gmail.com
CONTACT_TO_EMAIL=lilog.shop@gmail.com
# Facultatif. Défaut : onboarding@resend.dev (domaine de test Resend, qui
# n'écrit qu'au titulaire du compte). Dès qu'un domaine est vérifié :
# "Lil'OG <contact@lil-og.com>"
CONTACT_FROM_EMAIL=

# ── Mesure d'audience (facultatif) ──
# Publics par nature : ils circulent en clair dans chaque requête.
# Absents = le script correspondant n'est jamais injecté.
NEXT_PUBLIC_GA_ID=
# Doit être numérique (6 à 20 chiffres) : la valeur est interpolée dans un
# <script> inline, et une chaîne fantaisiste y serait du code exécutable.
NEXT_PUBLIC_META_PIXEL_ID=
