            <span class="win95-btn"></span>
          </div>
        </div>

        <div class="terminal-screen">
          <div class="terminal-content">
            <span class="terminal-noise">░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░</span>
